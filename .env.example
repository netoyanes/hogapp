VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Ronqueo · Bruma Records (venta de boletos con Stripe) ──────────────────
# Estas NO van en Vercel ni en el front: son secrets de la edge function
# `ronqueo-tickets` (Supabase → Edge Functions → Secrets). La secret key de
# Stripe nunca debe llegar al navegador.
#
# STRIPE_SECRET_KEY=sk_test_...            # sk_live_... en producción
# STRIPE_WEBHOOK_SECRET=whsec_...          # del endpoint del webhook en Stripe
# PUBLIC_SITE_URL=https://hogapp-smoky.vercel.app   # base de success/cancel URLs
# RESEND_API_KEY=re_...                    # correo de confirmación con el código
# RONQUEO_FROM_EMAIL="Bruma Records <boletos@tu-dominio-verificado.com>"
