{
  "rewrites": [
    {
      "source": "/r/:code",
      "destination": "https://ksxgxdewrwoslpnvvqnm.supabase.co/functions/v1/og-share?kind=r&code=:code"
    },
    {
      "source": "/w/:code",
      "destination": "https://ksxgxdewrwoslpnvvqnm.supabase.co/functions/v1/og-share?kind=w&code=:code"
    },
    {
      "source": "/p/:code",
      "destination": "https://ksxgxdewrwoslpnvvqnm.supabase.co/functions/v1/og-share?kind=p&code=:code"
    },
    {
      "source": "/simon",
      "destination": "/simon.html"
    },
    {
      "source": "/ronqueo",
      "destination": "/ronqueo.html"
    },
    {
      "source": "/ronqueo/gracias",
      "destination": "/ronqueo.html"
    },
    {
      "source": "/cenote",
      "destination": "/cenote.html"
    },
    {
